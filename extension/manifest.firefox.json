{
  "manifest_version": 3,
  "name": "Pako",
  "short_name": "Pako",
  "version": "1.2.6",
  "description": "Send downloads, links and videos to Pako, your download manager.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "contextMenus",
    "downloads",
    "nativeMessaging",
    "cookies",
    "storage",
    "scripting",
    "activeTab",
    "webRequest"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*",
        "https://www.youtube-nocookie.com/embed/*",
        "https://vimeo.com/*",
        "https://player.vimeo.com/video/*",
        "https://www.twitch.tv/*",
        "https://clips.twitch.tv/*",
        "https://www.facebook.com/*",
        "https://web.facebook.com/*",
        "https://www.instagram.com/*"
      ],
      "js": [
        "pill.js",
        "player.js"
      ],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Pako",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "background": {
    "scripts": [
      "background.js"
    ]
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "extension@pako.sookera.com",
      "strict_min_version": "128.0",
      "update_url": "https://github.com/sookera/pako-releases/releases/latest/download/firefox-updates.json",
      "data_collection_permissions": {
        "required": [
          "authenticationInfo",
          "browsingActivity",
          "websiteContent"
        ]
      }
    }
  }
}
