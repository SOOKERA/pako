{
  "manifest_version": 3,
  "name": "Pako",
  "short_name": "Pako",
  "version": "1.2.0",
  "description": "Send downloads, links and videos to Pako, your download manager.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "contextMenus",
    "downloads",
    "nativeMessaging",
    "cookies",
    "storage",
    "scripting",
    "activeTab"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*",
        "https://www.youtube-nocookie.com/embed/*",
        "https://vimeo.com/*",
        "https://player.vimeo.com/video/*",
        "https://www.twitch.tv/*",
        "https://clips.twitch.tv/*",
        "https://www.facebook.com/*",
        "https://web.facebook.com/*",
        "https://www.instagram.com/*"
      ],
      "js": [
        "player.js"
      ],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Pako",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "key": "",
  "background": {
    "service_worker": "background.js"
  }
}
