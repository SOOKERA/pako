{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Pako",
  "mainBinaryName": "Pako",
  "version": "1.4.2",
  "identifier": "com.sookera.pako",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "title": "Pako",
        "width": 1440,
        "height": 860,
        "minWidth": 900,
        "minHeight": 520,
        "center": true,
        "visible": false,
        "decorations": false,
        "dragDropEnabled": false,
        "shadow": true,
        "backgroundColor": "#0F1114"
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data:",
        "media-src": "'self' http://127.0.0.1:*",
        "font-src": "'self' data:",
        "connect-src": "ipc: http://ipc.localhost http://tauri.localhost/_app/version.json",
        "object-src": "'none'",
        "base-uri": "'self'",
        "frame-src": "'none'"
      },
      "devCsp": null,
      "dangerousDisableAssetCspModification": ["style-src"]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "Sookera",
    "copyright": "Sookera",
    "homepage": "https://pako.sookera.com",
    "shortDescription": "Pako download manager",
    "resources": { "../LICENSE": "LICENSE", "../NOTICE.md": "NOTICE.md", "../TERMS.md": "TERMS.md", "../TERMS.fr.md": "TERMS.fr.md" },
    "licenseFile": "gen/terms.txt",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper", "silent": true },
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico",
        "languages": ["English", "French"],
        "displayLanguageSelector": false,
        "customLanguageFiles": { "English": "installer/English.nsh", "French": "installer/French.nsh" },
        "installerHooks": "installer/hooks.nsh",
        "template": "installer/installer.nsi"
      }
    }
  }
}
